# Salin menjadi .env lalu sesuaikan.
# Di server, file ini yang dibaca systemd lewat EnvironmentFile.

# ─── Database (wajib) ────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/simple_rust_local

# ─── Server ──────────────────────────────────
# Boleh ditulis ":8080" (gaya Go) atau "0.0.0.0:8080".
API_ADDR=:8080

# ─── CORS ────────────────────────────────────
# Daftar origin frontend, dipisah koma. "*" mengizinkan semua (default).
WEB_ORIGIN=*

# ─── Tuning (opsional, ada nilai defaultnya) ──
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=30

# ─── Log ─────────────────────────────────────
RUST_LOG=info,sqlx=warn
