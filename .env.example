# Salin menjadi .env lalu sesuaikan.
# Di server, file ini yang dibaca systemd lewat EnvironmentFile.

# ─── Database (wajib) ────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/simple_rust_local

# ─── Server ──────────────────────────────────
# Boleh ditulis ":8080" (gaya Go) atau "0.0.0.0:8080".
API_ADDR=:8080

# ─── CORS ────────────────────────────────────
# Daftar origin frontend, dipisah koma. "*" mengizinkan semua (default).
WEB_ORIGIN=*

# ─── Tuning (opsional, ada nilai defaultnya) ──
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=30

# ─── Sinkronisasi dari Apps Script (opsional) ─
# Endpoint POST /api/comments/sync baru aktif kalau KEDUANYA diisi;
# kalau kosong, endpoint menjawab 503 — bukan jalan dengan kunci default.
SYNC_SOURCE_URL=https://script.google.com/macros/s/xxxxx/exec
SYNC_SECRET=ganti-dengan-kata-rahasia
# Apps Script bisa menjawab sangat lambat (puluhan detik).
SYNC_TIMEOUT_SECONDS=120

# ─── Endpoint kompatibel Apps Script (/exec) ──
# Frontend lama mengirim tanggal tanpa zona waktu ("2026-09-09 23:42").
# Angka jamnya ditafsirkan pada zona ini. 7 = WIB.
LEGACY_UTC_OFFSET_HOURS=7

# ─── Log ─────────────────────────────────────
RUST_LOG=info,sqlx=warn
